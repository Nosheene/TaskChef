# Copier vers .env pour un lancement local (sans Docker) : cp .env.example .env
# Ne pas commiter le fichier .env réel.

PORT=3000
NODE_ENV=development

JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=taskchef

MONGO_URI=mongodb://localhost:27017/taskchef

# Optionnel : tentatives d’attente au boot (défaut 30 dans server.js)
# MYSQL_RETRY_ATTEMPTS=30
# MONGO_RETRY_ATTEMPTS=30
