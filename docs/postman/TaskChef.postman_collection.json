{
  "info": {
    "name": "TaskChef API",
    "description": "Collection pour tester l'API TaskChef (Docker local par défaut). Après **Login**, le jeton est enregistré dans les variables de collection `token` et `task_id` (création de tâche).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "task_id", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Public",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "GET /tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tasks"
          }
        },
        {
          "name": "GET /tasks/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tasks/{{task_id}}"
          }
        }
      ]
    },
    {
      "name": "02 - Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Test Postman\",\n  \"email\": \"postman.test@taskchef.local\",\n  \"mot_de_passe\": \"Postman12345\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) {",
                  "    pm.collectionVariables.set('token', j.token);",
                  "    console.log('Variable collection token mise a jour');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.test@taskchef.local\",\n  \"mot_de_passe\": \"Postman12345\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "03 - Protégé (JWT)",
      "item": [
        {
          "name": "POST /tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.id) {",
                  "    pm.collectionVariables.set('task_id', String(j.id));",
                  "    console.log('task_id =', j.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Tache creee via Postman\",\n  \"description\": \"Test API\",\n  \"statut\": \"a_faire\",\n  \"priorite\": \"moyenne\",\n  \"date_limite\": \"2026-12-31\"\n}"
            },
            "url": "{{base_url}}/tasks"
          }
        },
        {
          "name": "PUT /tasks/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Tache mise a jour Postman\",\n  \"description\": \"Mise a jour\",\n  \"statut\": \"en_cours\",\n  \"priorite\": \"haute\",\n  \"date_limite\": \"2026-11-15\"\n}"
            },
            "url": "{{base_url}}/tasks/{{task_id}}"
          }
        },
        {
          "name": "GET /activity-logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/activity-logs"
          }
        },
        {
          "name": "DELETE /tasks/:id (admin uniquement)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/tasks/{{task_id}}"
          }
        }
      ]
    }
  ]
}
